# Call Center Intelligence System — Environment Configuration
# Copy this file to .env and fill in your API keys.

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Which LLM to use: openai | gemini | groq
LLM_PROVIDER=openai

# OpenAI API key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Google Gemini API key (required when LLM_PROVIDER=gemini)
# Get a free key at https://aistudio.google.com/
GOOGLE_API_KEY=

# Groq API key (required when LLM_PROVIDER=groq)
# Get a free key at https://console.groq.com/
GROQ_API_KEY=

# ─── Whisper / Transcription ───────────────────────────────────────────────────
# Model size: tiny | base | small | medium | large-v3
# Use tiny for development (fast), large-v3 for GPU production (accurate)
WHISPER_MODEL_SIZE=tiny

# Minimum per-segment confidence to accept (0.0–1.0)
CONFIDENCE_THRESHOLD=0.4

# Fraction of low-confidence segments that triggers a halt flag (0.0–1.0)
LOW_CONFIDENCE_HALT_RATIO=0.5

# ─── Database ─────────────────────────────────────────────────────────────────
# Path to the SQLite database file (created at runtime)
DB_PATH=data/calls.db

# Optional encryption key for SQLite (requires SQLCipher)
DB_ENCRYPTION_KEY=

# ─── Pipeline Settings ────────────────────────────────────────────────────────
# Maximum LLM retry attempts per pipeline node (1–5)
MAX_RETRIES_PER_NODE=3

# LLM API timeout in seconds
LLM_TIMEOUT_SECONDS=60

# ─── LangSmith Observability (optional) ───────────────────────────────────────
# Set to true to enable full LangGraph trace logging
LANGCHAIN_TRACING_V2=false

# LangSmith API key (required when LANGCHAIN_TRACING_V2=true)
LANGCHAIN_API_KEY=

# LangSmith project name for this application
LANGCHAIN_PROJECT=call-center-intelligence
